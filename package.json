{
  "name": "favicon-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Favicon generator that runs entirely in the browser.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:browser": "node --test --test-concurrency=4 \"tests/browser/*.test.js\"",
    "test:perf": "node --test --test-name-pattern=\"dragging a slider\" tests/browser/checks.test.js",
    "build-sw": "node tools/build-sw.js",
    "app-icon": "node tools/make-app-icon.js",
    "og-image": "node tools/make-og-image.js",
    "readme-media": "node tools/make-readme-media.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "decode-ico": "^0.4.1",
    "fflate": "^0.8.3",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  }
}
